{
  "name": "pulsehr-backend",
  "version": "1.0.0",
  "description": "PulseHR API server",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "dev":         "ts-node-dev --respawn --transpile-only --exit-child src/index.ts",
    "build":       "tsc --project tsconfig.json",
    "start":       "node dist/index.js",
    "db:migrate":  "dotenv -e ../.env -- npx prisma migrate dev",
    "db:deploy":   "dotenv -e ../.env -- npx prisma migrate deploy",
    "db:seed":     "dotenv -e ../.env -- ts-node prisma/seed.ts",
    "db:studio":   "dotenv -e ../.env -- npx prisma studio",
    "db:reset":    "dotenv -e ../.env -- npx prisma migrate reset --force",
    "db:generate": "dotenv -e ../.env -- npx prisma generate",
    "test":        "vitest run",
    "test:watch":  "vitest"
  },
  "dependencies": {
    "@prisma/client":        "^5.17.0",
    "bcryptjs":              "^2.4.3",
    "compression":           "^1.7.4",
    "cors":                  "^2.8.5",
    "date-fns":              "^3.6.0",
    "dotenv":                "^16.4.5",
    "express":               "^4.19.2",
    "express-rate-limit":    "^7.4.0",
    "helmet":                "^7.1.0",
    "jsonwebtoken":          "^9.0.2",
    "morgan":                "^1.10.0",
    "multer":                "^1.4.5-lts.1",
    "nodemailer":            "^6.9.14",
    "pdfkit":                "^0.15.0",
    "rate-limit-redis":      "^4.2.0",
    "redis":                 "^4.7.0",
    "swagger-jsdoc":         "^6.2.8",
    "swagger-ui-express":    "^5.0.1",
    "zod":                   "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs":           "^2.4.6",
    "@types/compression":        "^1.7.5",
    "@types/cors":               "^2.8.17",
    "@types/express":            "^4.17.21",
    "@types/jsonwebtoken":       "^9.0.6",
    "@types/morgan":             "^1.9.9",
    "@types/multer":             "^1.4.11",
    "@types/node":               "^20.14.10",
    "@types/nodemailer":         "^6.4.15",
    "@types/pdfkit":             "^0.13.4",
    "@types/supertest":          "^6.0.2",
    "@types/swagger-jsdoc":      "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "dotenv-cli":                "^7.4.2",
    "prisma":                    "^5.17.0",
    "supertest":                 "^7.0.0",
    "ts-node":                   "^10.9.2",
    "ts-node-dev":               "^2.0.0",
    "typescript":                "^5.5.3",
    "vitest":                    "^1.6.0"
  }
}
