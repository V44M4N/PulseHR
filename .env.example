# PulseHR — single env file for the whole monorepo
# Copy to .env at the repo root and fill in values
# NEVER commit .env to version control

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# These VITE_* vars are baked into the browser bundle at build time
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_APP_NAME=PulseHR
VITE_ENABLE_MOCK=false

# ─── Backend — Server ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Backend — Database ──────────────────────────────────────────────────────
# Local dev:    postgresql://postgres:password@localhost:5432/pulsehr
# Docker:       docker-compose overrides host to "postgres" (service name)
DATABASE_URL=postgresql://postgres:password@localhost:5432/pulsehr

# ─── Backend — Redis ─────────────────────────────────────────────────────────
# Local dev:    redis://localhost:6379
# Docker:       docker-compose overrides host to "redis" (service name)
REDIS_URL=redis://localhost:6379

# ─── Backend — JWT ───────────────────────────────────────────────────────────
# Generate strong secrets: openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_generate_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=change_me_generate_with_openssl_rand_hex_32_different
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Backend — File Storage ───────────────────────────────────────────────────
# "local" for dev (saves to backend/uploads/), "s3" for production
FILE_STORAGE=local
AWS_BUCKET=pulsehr-uploads
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Backend — Email ──────────────────────────────────────────────────────────
# Dev: use Mailtrap (https://mailtrap.io) — free inbox for testing
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@pulsehr.io

# ─── Backend — CORS ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:8080

# ─── Docker Compose ───────────────────────────────────────────────────────────
# Used by docker-compose.yml, docker-compose.fullstack.yml, docker-compose.prod.yml
# to configure the postgres service and override DATABASE_URL inside containers
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=pulsehr
# Optional: Redis password for production (leave empty for dev)
REDIS_PASSWORD=

# ─── App Config Note ─────────────────────────────────────────────────────────
# All application configuration beyond infrastructure credentials —
# SSO, MFA, IP allowlist, leave types, holiday calendar, salary structures,
# notification templates, timezone, workflows — is stored in the
# CompanySetting database table and managed through the Admin Settings UI.
# Never add new env vars for app-level config.
