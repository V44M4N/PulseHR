# ─── Dependencies ──────────────────────────────────────
node_modules
frontend/node_modules
backend/node_modules

# ─── Build outputs ─────────────────────────────────────
dist
dist-ssr
frontend/dist
backend/dist

# ─── Environment variables (NEVER commit) ──────────────
# Single .env lives at repo root — never commit it
.env
.env.local
.env.*.local

# ─── Logs ──────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── File uploads (local dev storage) ──────────────────
backend/uploads/*
!backend/uploads/.gitkeep

# ─── Editor ────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Docker ────────────────────────────────────────────
docker/volumes/

# ─── Misc ──────────────────────────────────────────────
*.local

# ─── Local report-generation work files ─────────────────
tmp/
